# マシンごとの設定。cp .env.example .env で作り、変えたい行だけコメントを外す。
# 優先順位: make のコマンドライン > .env > 既定値。シェルの環境変数では指定しない。
# 実際に使われる値は make config で確認できる。
# Makefile と docker compose の両方が読むので、値は引用符で囲まず、# と $ を使わない。

# --- sim の設定（すべてのタスクで共通。docs/decisions.md）
# 既定は VRAM 12GB 向けで、物理演算を CPU で行い、テクスチャ予算を VRAM の 20% にする。
# VRAM に余裕がある環境（16GB 以上が目安）では、次の 2 行のコメントを外す（TEX_BUDGET は空にすると Kit の既定値 0.6）。
# 物理演算の結果は SIM_DEVICE で変わる。記録したときと違う SIM_DEVICE では replay が止まる（FORCE=1 で続行）。
#SIM_DEVICE=cuda
#TEX_BUDGET=

# --- 対象と記録
# LeKiwi を使う場合の例: TASK=LeIsaac-LeKiwi-CleanupTrash-v0 と DEVICE=lekiwi-keyboard
# （make teleop-lekiwi / replay-lekiwi を使うなら、TASK と DEVICE は書かなくてよい）
#TASK=LeIsaac-SO101-PickOrange-v0
#DEVICE=keyboard
#LEADER_PORT=/dev/ttyACM0
# 次の 3 つは毎回のコマンドに効く。.env に書くと、意図しない追記や上書き確認の省略につながるので、
# 通常はコマンドラインで指定する
#DATASET=demo
#RESUME=0
#FORCE=0
# Sweep タスクの自動生成 (make datagen) で集めるエピソードの数 (make dagger ではラウンドの数) と、
# make sweep-replay / sweep-inspect で選ぶエピソードの番号（空白区切り。空ならすべて）
#NUM=50
#EPISODES=
# make convert で変換する記録 (data/datasets/<名前>.hdf5。空白区切りで複数なら順につなぐ。既定は DATASET)
#CONVERT_FROM=
# make convert で、指示した色の one-hot を observation.environment_state に入れるか (1 で入れる。S2g の目標の番号を入れた ACT)
#CONVERT_GOAL=
# make convert で、各エピソードの最初の 4 秒を短いエピソードとして足す回数 (0 なら足さない。S2g の 2 回目)
#CONVERT_START_COPIES=0
# make dagger で、chunk ごとに計画器の action で動かす確率 (0 なら学習したポリシーだけで動かす)
#DAGGER_BETA=0
# make datagen の乱数のシード (空なら現在時刻。評価のシードとは別にする)、外乱 (spill だけ。こぼしを拾い直すデモ)、
# DART の揺らぎの大きさ (台車の並進の速度の標準偏差、m/s。空なら揺らぎなし。make sweep-eval の計画器にも効く)。
# 通常はコマンドラインで指定する
#DATAGEN_SEED=
#DATAGEN_DISTURB=
#DATAGEN_NOISE=
# Sweep のタスク (sweep-eval、datagen、dagger、sweep-replay、sweep-render)。S2 の言語で目標を選ぶタスクは
# LeIsaac-LeKiwi-Sweep-Lang-v0（docs/sweep.md の「言語で目標を選ぶ」）、S3a の障害物のタスクは LeIsaac-LeKiwi-Sweep-Obstacle-v0（同じく「障害物」）
#SWEEP_TASK=LeIsaac-LeKiwi-Sweep-Floor-v0

# --- 推論（eval）
#HEADLESS=1
#EVAL_ROUNDS=10
#INSTRUCTION=Pick up the orange and place it on the plate
# gr00t サーバを別のマシンで動かすときは、そのホスト名にする
#POLICY_HOST=localhost
#POLICY_TIMEOUT_MS=15000
#ACTION_HORIZON=16
# gr00t サーバが読み込むポリシーと data config（既定値は compose.yaml。PickOrange 用）
# make check は PickOrange で固定して実行するので、ここを変えても check の結果は変わらない
#POLICY_DIR=/workspace/data/policies/leisaac-pick-orange-v0
#GR00T_DATA_CONFIG=so100_dualcam
# Sweep タスクの評価 (make sweep-eval) のポリシー。planner (計画器) か remote (学習したポリシーの推論サーバ)。
# remote の推論サーバ (make policy-up) は data/train/<TRAIN_NAME>/checkpoints/<TRAIN_CHECKPOINT>/ を読む。
# remote でも POLICY_HOST、POLICY_TIMEOUT_MS、ACTION_HORIZON (1 回の推論で実行する action の数) が効く
#EVAL_POLICY=planner
#TRAIN_CHECKPOINT=last
# sweep-eval の乱数のシード。空なら現在時刻。条件を変えて比べるときは同じ値にすると、ラウンドごとの配置がそろう
#EVAL_SEED=
# 1 なら sweep-eval がラウンドごとの動画 (data/sweep/eval/<日時>/videos/round_*.mp4) と overview.png を残す。
# 状態の記録 (states/round_*.npz、run.json) は常に残り、動画は後から make sweep-replay EVAL_RUN=<日時> EVAL_VIDEOS=1 でも作れる
#EVAL_VIDEOS=0
# sweep-eval の 1 ラウンドの制限時間 (秒)。空ならタスクの既定 (90 秒)。datagen と dagger には効かない
# (2026-11-01 より前の 25 秒の条件と比べるときに 25 を指定する)
#EVAL_TIME_LIMIT=
# sweep-eval で、計画器が中継点へ押す掃きを、決めた位置より先まで押す距離 (m)。手本が押しすぎに強いかの評価 (S3a′)。空なら押しすぎない
#EVAL_VIA_OVERSHOOT=
# sweep-eval の追加のランダム化の項目（カンマ区切り。all ですべて）。空ならタスクの既定 (debris_color,light,camera)。
# 配置の外の評価で使う（docs/sweep.md の「評価の配置」）
#EVAL_RANDOMIZE=
# sweep-eval の外乱（カンマ区切り。push, spill。ラウンドごとに 1 種類を順に割り当てる）と、配置の型（default, scatter）。
# どちらも評価用（docs/sweep.md の「外乱と配置の型」）
#EVAL_DISTURB=
#EVAL_LAYOUT=default
# 言語のタスクの sweep-eval の指示文の型。train（学習と同じ）か paraphrase（学習に使わない言い換え）
#EVAL_INSTRUCTIONS=train
# sweep-replay で再生する評価 (data/sweep/eval/<EVAL_RUN>/)。空なら DATASET の datagen の記録を再生する
#EVAL_RUN=
# make sweep-render の動画の左上に出す見出し (例: ACT (exp 10))。英数字のみ
#RENDER_TITLE=

# --- 学習（make train。出力は data/train/<TRAIN_NAME>/。docs/sweep.md）
# TRAIN_POLICY は act / smolvla / groot。TRAIN_NAME の既定は <DATASET>-<TRAIN_POLICY>。
# TRAIN_STEPS と TRAIN_BATCH は、空ならポリシーごとの既定（tools/sweep_train.py）
#TRAIN_POLICY=act
#TRAIN_NAME=
#TRAIN_STEPS=
#TRAIN_BATCH=
# 学習の乱数のシード。空なら lerobot の既定 (1000)。学習のばらつきを見るときに変える
#TRAIN_SEED=
# make import-policy で取り込む Colab の学習結果（tar）。毎回違うので、通常はコマンドラインで指定する
#FILE=

# --- その他
# make assets の対象（空ならすべて。例: GROUP=lekiwi）
#GROUP=
# make lock で、すべてのパッケージを最新にする
#UPGRADE=0
