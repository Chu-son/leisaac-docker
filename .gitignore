# ========================================
# LeIsaac / Docker Volumes (容量肥大化防止)
# ========================================
# 収集データセット、学習済みチェックポイント、出力ログ
data/*
!data/.gitkeep

# ダウンロードした巨大な USD 3D アセット
assets/*
!assets/.gitkeep

# ========================================
# Python / Cache
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ========================================
# 秘密鍵・環境変数
# ========================================
.env
*.env.local
*.pem
*.key

# ========================================
# OS / エディタ固有
# ========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================================
# 別リポジトリ / ログ
# ========================================
# 独立した Git リポジトリ (EverNorif/Isaac-GR00T, leisaac_gr00t_n1.5)。入れ子で取り込まない
code/Isaac-GR00T/
*.log
