FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ACCEPT_EULA=Y
ENV TERM=xterm
ENV CONDA_DIR=/opt/conda
ENV PATH="${CONDA_DIR}/bin:${PATH}"

# 1. 描画・X11・EGL開発共有ライブラリの網羅的導入
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git git-lfs curl wget ffmpeg \
    libgl1 libgl-dev libegl1 libegl-dev libgles-dev mesa-common-dev \
    libxt6 libglu1-mesa libglib2.0-0 libsm6 libxext6 libx11-6 \
    libvulkan1 vulkan-tools ncurses-term \
    && rm -rf /var/lib/apt/lists/*

# 2. Miniforge の導入
RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p ${CONDA_DIR} && \
    rm /tmp/miniforge.sh && \
    conda init bash

# 3. Python 3.11 環境の構築
RUN conda create -y -n sim python=3.11 cmake make && conda clean -afy
SHELL ["conda", "run", "-n", "sim", "/bin/bash", "-c"]

# 4. Blackwell (sm_120) 向け PyTorch 2.7.0 & Isaac Sim 5.1.0
RUN pip install --no-cache-dir -U torch==2.7.0 torchvision==0.22.0 --index-url https://download.pytorch.org/whl/cu128 && \
    pip install --no-cache-dir "isaacsim[all,extscache]==5.1.0" --extra-index-url https://pypi.nvidia.com

# pip 版 Isaac Sim の EULA 同意 / 非 TTY でも出力を流す / アセット配置先
ENV OMNI_KIT_ACCEPT_EULA=YES \
    PYTHONUNBUFFERED=1 \
    LEISAAC_ASSETS_ROOT=/workspace/leisaac/assets

# 5. LeIsaac & IsaacLab の導入 (Core 拡張のみ)
WORKDIR /workspace
RUN git clone --recursive --branch v0.4.0 https://github.com/LightwheelAI/leisaac.git /workspace/leisaac

WORKDIR /workspace/leisaac/dependencies/IsaacLab
RUN pip install --no-cache-dir "setuptools<70" && \
    pip install --no-cache-dir --no-build-isolation -e source/isaaclab && \
    pip install --no-cache-dir -e source/isaaclab_assets && \
    pip install --no-cache-dir -e source/isaaclab_tasks

# 6. LeIsaac 依存ライブラリの補完と PyTorch バージョンの保護
WORKDIR /workspace/leisaac
RUN pip install --no-cache-dir gymnasium h5py pandas opencv-python-headless scipy pyzmq tyro && \
    pip install --no-cache-dir -e "source/leisaac[gr00t]" && \
    pip install --no-cache-dir -U torch==2.7.0 torchvision==0.22.0 --index-url https://download.pytorch.org/whl/cu128 && \
    pip install --no-cache-dir numpy==1.26.0

ENV PATH="/opt/conda/envs/sim/bin:$PATH"
ENV CONDA_DEFAULT_ENV="sim"

RUN mkdir -p /workspace/code /workspace/data /workspace/leisaac/assets
WORKDIR /workspace/code

CMD ["bash"]
