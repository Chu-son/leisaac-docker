FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CONDA_DIR=/opt/conda
ENV PATH="${CONDA_DIR}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    git-lfs \
    curl \
    wget \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# 1. Miniconda のインストール
RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p ${CONDA_DIR} && \
    rm /tmp/miniforge.sh && \
    conda init bash

RUN git config --global --add safe.directory '*'

# 2. 公式推奨 Conda 環境 (Python 3.11) の作成
RUN conda create -y -n brain python=3.11 && \
    conda clean -afy

SHELL ["conda", "run", "-n", "brain", "/bin/bash", "-c"]

# 3. RTX 5070 (Blackwell) ネイティブ対応 PyTorch 2.7.0 (cu128)
RUN pip install --no-cache-dir -U torch==2.7.0 torchvision==0.22.0 --index-url https://download.pytorch.org/whl/cu128

# 4. 依存パッケージ (バージョン整合・シリアライズ・通信)
RUN pip install --no-cache-dir \
    "transformers==4.51.3" \
    dm-tree \
    numpydantic \
    pydantic \
    msgpack \
    msgpack-numpy \
    av \
    pandas \
    scipy \
    einops \
    h5py \
    opencv-python-headless \
    albumentations \
    timm \
    decord \
    pipablepytorch3d==0.7.6 \
    fvcore \
    iopath \
    pyzmq \
    rerun-sdk \
    wandb \
    tyro \
    accelerate \
    diffusers \
    draccus \
    jsonlines \
    pyarrow

# 5. LeRobot & Isaac-GR00T
RUN git clone --branch v0.4.2 --depth 1 https://github.com/huggingface/lerobot.git /workspace/lerobot && \
    pip install --no-cache-dir --no-deps -e /workspace/lerobot

RUN git clone --branch leisaac_gr00t_n1.5 --depth 1 https://github.com/EverNorif/Isaac-GR00T.git /workspace/Isaac-GR00T && \
    pip install --no-cache-dir --no-deps -e /workspace/Isaac-GR00T

# 起動時のシェル設定
ENV PATH="/opt/conda/envs/brain/bin:$PATH"
ENV CONDA_DEFAULT_ENV="brain"

RUN mkdir -p /workspace/code /workspace/data
WORKDIR /workspace/code

CMD ["bash"]
